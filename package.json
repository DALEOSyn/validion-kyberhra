{
  "name": "kancelaria-stopa",
  "private": true,
  "version": "0.1.0",
  "description": "Kancelária STOPA: a free Slovak browser game that teaches children aged 11-15 to spot online scams. Code MIT, content CC BY-SA 4.0.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "redline": "tsx scripts/redline-lint.ts",
    "validate": "tsx scripts/validate-content.ts",
    "e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm test && npm run redline && npm run build"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.10",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
